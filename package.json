{
  "name": "followthru",
  "version": "1.0.0",
  "description": "Study planner for neurodivergent students that runs itself",
  "scripts": {
    "start": "npx --yes serve -l 3000 .",
    "build:vendor": "esbuild build/chrono-entry.js --bundle --format=esm --minify --outfile=vendor/chrono.mjs && cp node_modules/pdfjs-dist/build/pdf.min.js node_modules/pdfjs-dist/build/pdf.worker.min.js vendor/",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "chrono-node": "^2.10.3",
    "pdfjs-dist": "^3.11.174"
  },
  "type": "module",
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
